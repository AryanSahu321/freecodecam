<!-- views/posts.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Civic Issue Reporting</title>
  </head>
  <body>
    <h1>Civic Issues & Complaints</h1>
    <p>Total Complaints: <%= total %></p>
    <a href="/posts/new" class="new-post-button">Report New Issue</a>

    <% posts.forEach((post) => { %>
      <div class="post">
        <h3 class="user">@ <%= post.USERNAME %></h3>
        <p class="content"><%= post.CONTENT %></p>
        <p class="content">id: <%= post.ID %></p>
        <a href="/comments/<%= post.ID %>" class="new-post-button">See in detail</a>
        &nbsp;&nbsp;
        <a href="/comments/<%= post.ID %>/edit" class="post-update">edit</a>
        <br />
        <form action="/comments/<%= post.ID %>?_method=DELETE" method="post">
          <button>delete</button>
        </form>
      </div>
    <% }); %>
  </body>
</html>