<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Show Chat</title>
  </head>
  <body>
    <div class="chat">
      <h1>Show Chat</h1>
      <p><strong>From:</strong> <%= chat.from %></p>
      <p><strong>To:</strong> <%= chat.to %></p>
      <p class="msg"><strong>Message:</strong> <%= chat.msg %></p>
      <p><strong>Created At:</strong> <%= chat.created_at %></p>
    </div>
  </body>
</html>

  </body>
</html>
