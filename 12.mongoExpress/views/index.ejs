<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Chats</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h3>All Chats!</h3>

    <form action="/chats/new" method="get">
        <button>New Chat</button>
    </form>

    <!-- FIX: Loop must be inside the body and wrapped in EJS control tags -->
    <% for(let chat of chats) { %>
        <div class="chat">
            <p>From: <%= chat.from %></p>
            <div class="msg">
                <p><%= chat.msg %></p>
            </div>
            <p>Received by: <%= chat.to %></p>
             <%= chat.created_at.toString().split(" ")[4]%> <br>
             <%= chat.created_at.toString().split(" ").slice(0,4).join(" ")%> <br><br> 
             <form action="/chats/<%= chat._id %>/edit" method="get">
                <button>Edit </button>
            </form>
            &nbsp; 
            <form action="/chats/<%= chat._id %>?_method=DELETE" method="POST"    
                 onsubmit="return confirm('Are you sure you want to delete this chat? This action cannot be undone.');">
                <button type="submit">Delete</button>
            </form>
            &nbsp;
            <form action="/chats/<%= chat._id %>" method="get">
                <button>Show</button>
            </form>
        <hr>
        </div>
       
    <% } %>

</body>
</html>
