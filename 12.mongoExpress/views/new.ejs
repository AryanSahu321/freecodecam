<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <title>Write new chat</title>
  </head>
  <body>
    <h3>Write new chat..</h3>

    <!-- FIX: Added method and action attributes to send data to your backend -->
    <form method="POST" action="/chats">
      <input placeholder="who are you?" name="from" /><br /><br />
      <textarea name="msg" placeholder="Write your message here.."></textarea
      ><br /><br />
      <input placeholder="add receiver" name="to" /><br /><br />
      <button type="submit">Create Chat</button>
    </form>
  </body>
</html>
