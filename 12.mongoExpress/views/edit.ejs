<!DOCTYPE DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    //Absolute see fromm root not in same folder //

    <title>Edit your chat</title>
  </head>
  <body>
    <div class="chat">
      <p>Edit your chat: <%= chat._id %></p>
      <p class="msg">
        This chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b>
      </p>

      <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <textarea class="msg" name="msg" rows="6" cols="50">
<%= chat.msg %></textarea
        >
        <br />
        <br />
        <button>Edit</button>
      </form>
    </div>
  </body>
</html>
